# --------------------------------------------------------------------------- #
# coder bot — environment template
# --------------------------------------------------------------------------- #
# Copy this file to `.env` and fill in the values you need:
#     cp .env.example .env
# All keys are OPTIONAL unless noted. The bot will pick safe defaults for
# anything you leave blank.
# --------------------------------------------------------------------------- #

# ---- Provider selection ---------------------------------------------------- #
# "cloud" → talk to OpenRouter (https://openrouter.ai/api/v1)
#           Requires OPENROUTER_API_KEY below.
# "local" → talk to a local Ollama server at http://localhost:11434/v1
#           No real API key needed.
PROVIDER=local

# ---- API keys -------------------------------------------------------------- #
# Required when PROVIDER=cloud. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Ollama ignores the key, but the OpenAI SDK refuses an empty
# string, so we pass this dummy value when no key is configured.
OLLAMA_API_KEY=ollama

# ---- Models ---------------------------------------------------------------- #
# Active model for the cloud (OpenRouter) provider.
# Browse free tool-capable options at https://openrouter.ai/models?max_price=0
CLOUD_MODEL=poolside/laguna-s-2.1:free

# Active model for the local (Ollama) provider.
# Pull it first, e.g.:  ollama pull qwen2.5-coder:7b
LOCAL_MODEL=qwen2.5-coder:7b

# ---- Sandbox + behaviour --------------------------------------------------- #
# Filesystem root the bot is sandboxed to. Use "." for the project root, or
# an absolute path like "/Users/me/projects/my-app".
CODER_ROOT=.

# "ask"  → confirm every write / edit / delete / shell command (default).
# "auto" → run without asking (destructive commands are still hard-blocked).
CODER_MODE=ask

# Max number of tool-calling rounds the model can do per turn.
CODER_MAX_TOOL_ROUNDS=15

# Timeout (seconds) for any shell command the bot runs.
CODER_CMD_TIMEOUT=30

# Optional. Override the chat-history file location. If unset, the bot
# stores history at <project_root>/.coder_history.json.
# CODER_HISTORY_FILE=/path/to/.coder_history.json

# ---- Voice ----------------------------------------------------------------- #
# Enable speech-to-text (microphone) input? "1" = on, anything else = off.
# Voice is OFF by default. Even when "1", the bot runs a self-check at
# startup and falls back to text if the microphone isn't usable.
# Toggle at runtime with `voice`.
CODER_VOICE=0

# Enable text-to-speech (speaker) output? "1" = on, anything else = off.
# When OFF, the bot never reads replies aloud automatically. Toggle at
# runtime with `say on` / `say off`, or speak one-off text with `say <text>`.
CODER_TTS=0

# ---- Debug ----------------------------------------------------------------- #
# Set to 1 to print full tracebacks for every caught exception. Helpful when
# the REPL exits unexpectedly and you want to see exactly what blew up.
# CODER_BOT_DEBUG=1
